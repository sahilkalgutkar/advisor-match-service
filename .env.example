# Host ports the compose stack publishes. Both are overridable, because 9200 is
# taken on any machine already running an Elasticsearch or OpenSearch, and 8080
# is the default for most things. Only the host side moves -- inside the
# compose network the API still reaches Elasticsearch on
# http://elasticsearch:9200, so nothing in the stack needs changing.
#
# Copy this to .env, or set them inline:
#   ELASTICSEARCH_HOST_PORT=9201 docker compose up --build

ELASTICSEARCH_HOST_PORT=9200
API_HOST_PORT=8080
